---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../data/site';
---
<SiteLayout title="Page Not Found | Rose Remodeling & Design" description="The page you're looking for isn't here. Explore our remodeling services or request a free estimate." noindex>
  <PageHead image={{ src: '/img/portfolio/full-house/full-house-01.webp' }} title="Page Not Found" intro="Sorry, that page isn’t here. It may have moved." crumbs={[{ href: '/', label: 'Home' }, { label: '404' }]}>
    <div class="hero__actions">
      <a class="btn btn--accent btn--lg" href="/">Back to Home</a>
      <a class="btn btn--outline btn--lg" href="/services/">Our Services</a>
      <a class="btn btn--outline btn--lg" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
    </div>
  </PageHead>
</SiteLayout>
