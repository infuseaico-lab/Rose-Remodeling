---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PageHead from '../../../components/PageHead.astro';
import { videoPortfolio, embedUrl, watchUrl } from '../../../data/videoPortfolio';
const [lead, ...rest] = videoPortfolio;
---
<SiteLayout title="Remodeling Project Videos | Rose Remodeling & Design" description="Walkthrough videos of kitchen, bathroom, addition and whole-home remodels by Rose Remodeling & Design in Sunnyvale and the Bay Area.">
  <PageHead image={{ src: "/img/portfolio/kitchen/kitchen-remodel-white-quartz-countertops-wood-bar-02.webp" }} title="Video Portfolio" intro={`${videoPortfolio.length} walkthrough videos of recent Rose Remodeling & Design projects.`} crumbs={[{ href: '/', label: 'Home' }, { href: '/portfolio/', label: 'Portfolio' }, { label: 'Videos' }]} />

  <section class="section">
    <div class="wrap">
      <figure class="vp vp--lead" data-reveal>
        <div class="vp__frame"><iframe src={embedUrl(lead)} title={lead.title} loading="lazy" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
        <figcaption><strong>{lead.title}</strong>{lead.place && <span>{lead.place}</span>}</figcaption>
      </figure>
      <ul class="vpgrid">
        {rest.map((v) => (
          <li class="vp" data-reveal>
            <div class="vp__frame"><iframe src={embedUrl(v)} title={v.title} loading="lazy" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
            <div class="vp__cap"><strong>{v.title}</strong>{v.place && <span>{v.place}</span>}<a class="vp__ext" href={watchUrl(v)} target="_blank" rel="noopener">Watch on {v.platform === 'vimeo' ? 'Vimeo' : 'YouTube'}</a></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section dark cta cta--img cta--split">
    <img class="cta__bg" src="/img/portfolio/exterior/addition-exterior-retractable-pergola-wooden-seating-02.webp" srcset="/img/portfolio/exterior/addition-exterior-retractable-pergola-wooden-seating-02-800.webp 800w, /img/portfolio/exterior/addition-exterior-retractable-pergola-wooden-seating-02.webp 1600w" sizes="100vw" width="1600" height="1067" alt="" aria-hidden="true" loading="lazy" decoding="async" />
    <div class="wrap cta__inner">
      <div class="cta__copy"><h2 class="h2">Like what you see?</h2><p>Tell us about your project and Adir will call you back to book a free in-home consultation.</p></div>
      <div class="hero__actions"><a class="btn btn--accent btn--lg" href="/free-estimate/">Get a Free Estimate <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
    </div>
  </section>
</SiteLayout>
