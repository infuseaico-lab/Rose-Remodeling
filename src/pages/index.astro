---
import SiteLayout from '../layouts/SiteLayout.astro';
import EstimateForm from '../components/EstimateForm.astro';
import { site, services, steps, promises, videos, projects, platforms, reviews, faqs } from '../data/site';
import { slug } from '../data/nav';
import { serviceHref } from '../data/servicePages';
const tel = `tel:${site.phoneTel}`;
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
// "Find us on" logo strip: hidden for now. Set to true to show it again.
const showBadges = false;
---
<SiteLayout
  title="Kitchen & Bath Remodeling in Sunnyvale, CA | Rose Remodeling"
  description="Licensed Sunnyvale design-build remodeler for kitchens, bathrooms, ADUs, additions and whole homes in the Bay Area. Free in-home consultation: (510) 402-7165."
  preload={{ src: '/img/hero-backyard-1600.webp', srcset: '/img/hero-backyard-800.webp 800w, /img/hero-backyard-1600.webp 1600w', sizes: '100vw' }}
  schema={[faqLd]}
>
    <section class="hero" aria-labelledby="hero-title">
      <!-- First slide is a real photo; the other three are AI-generated stand-ins (OpenAI gpt-image-2). -->
      <div class="hero__slides" data-hero-slides>
        <img class="hero__bg is-on" src="/img/hero-backyard-1600.webp" srcset="/img/hero-backyard-800.webp 800w, /img/hero-backyard-1600.webp 1600w" sizes="100vw" width="1600" height="1064" alt="Backyard remodel at dusk: a covered composite deck with lit steps, a white pergola, lounge seating and a lawn" fetchpriority="high" />
        <img class="hero__bg" data-src="/img/hero-kitchen-1536.webp" data-srcset="/img/hero-kitchen-800.webp 800w, /img/hero-kitchen-1536.webp 1536w" sizes="100vw" width="1536" height="1024" alt="Modern kitchen with a white stone waterfall island and brass pendant lights at dusk (representative image)" />
        <img class="hero__bg" data-src="/img/hero-bath-1536.webp" data-srcset="/img/hero-bath-800.webp 800w, /img/hero-bath-1536.webp 1536w" sizes="100vw" width="1536" height="1024" alt="Spa-like primary bathroom with a freestanding tub, floating oak vanity and glass shower (representative image)" />
        <img class="hero__bg" data-src="/img/hero-living-1536.webp" data-srcset="/img/hero-living-800.webp 800w, /img/hero-living-1536.webp 1536w" sizes="100vw" width="1536" height="1024" alt="Open-plan living room with folding glass doors open to a lit backyard at twilight (representative image)" />
      </div>
      <div class="wrap hero__inner">
        <div class="hero__copy">
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-star"/></svg>Top 3 remodeler in Sunnyvale · 2025</span>
          <h1 class="hero__title" id="hero-title">Kitchen &amp; Bath Remodeling in <em>Sunnyvale</em> and the Bay Area</h1>
          <p class="hero__lead">Kitchens, bathrooms, ADUs, additions and whole homes, designed, permitted and built by one licensed team, with daily updates from your project manager.</p>
          <div class="hero__actions" data-hero-actions>
            <a class="btn btn--accent btn--lg" href="/#estimate">Get a Free Estimate <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a>
            <a class="btn btn--outline btn--lg" href={tel}><svg class="ico" aria-hidden="true"><use href="#i-phone"/></svg> {site.phoneDisplay}</a>
          </div>
          <ul class="facts">
            <li><svg class="ico" aria-hidden="true"><use href="#i-shield"/></svg> {site.license} · insured &amp; bonded</li>
            <li><svg class="ico" aria-hidden="true"><use href="#i-clipboard"/></svg> Permits handled</li>
            <li><svg class="ico" aria-hidden="true"><use href="#i-pin"/></svg> Sunnyvale &amp; Bay Area</li>
          </ul>
        </div>
        <div class="hero__media">
          <div class="score">
            <strong>{site.rating.value}</strong>
            <span><span class="stars" aria-hidden="true">★★★★★</span><br />Rated Excellent · {site.rating.count} Google reviews</span>
          </div>
        </div>
      </div>
    </section>

    <div class="ticker" role="region" aria-label="Service areas">
      <ul class="ticker__track">{site.areaServed.map((a) => <li>{a}</li>)}</ul>
      <ul class="ticker__track" aria-hidden="true">{site.areaServed.map((a) => <li>{a}</li>)}</ul>
    </div>

    <section class="section section--card" id="services" aria-labelledby="services-title">
      <div class="wrap">
        <header class="head" data-reveal>
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-layers"/></svg>Services</span>
          <h2 class="h2" id="services-title">What We Build</h2>
          <p>One design-build team and one contract, from a single bathroom to a new home.</p>
        </header>
        <ul class="svcs">
          {services.map((s, i) => (
            <li class="svc" id={slug(s.name)} data-reveal>
              {s.img
                ? <img class="svc__img" src={`${s.real ?? s.img}-800.webp`} srcset={s.real ? `${s.real}-800.webp 800w, ${s.real}.webp 1600w` : `${s.img}-800.webp 800w, ${s.img}-1536.webp 1536w`} sizes="(min-width: 75em) 590px, (min-width: 40em) 50vw, 100vw" width="1536" height="1024" alt={s.real ? `${s.name} by Rose Remodeling & Design` : `${s.name}: representative photo`} loading="lazy" />
                : <div class={`ph${i % 2 ? ' ph--light' : ''}`} role="img" aria-label={`${s.name} project`}><span><svg class="ico" aria-hidden="true"><use href="#i-image"/></svg>Photo: {s.name}</span></div>}
              <h3 class="h3"><span class="tile"><svg class="ico" aria-hidden="true"><use href={`#i-${s.icon}`}/></svg></span>{s.name}</h3>
              <p>{s.blurb}</p>
              <ul class="svc__list">{s.bullets.map((b) => <li>{b}</li>)}</ul>
              <a class="link" href={serviceHref(s.name)}>Learn more<span class="sr-only"> about {s.name.toLowerCase()}</span> <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="process" aria-labelledby="process-title">
      <div class="wrap">
        <header class="head" data-reveal>
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-clipboard"/></svg>Process</span>
          <h2 class="h2" id="process-title">How a Project Runs</h2>
          <p>Three stages, with a written proposal and a schedule before any wall comes down.</p>
        </header>
        <ol class="steps">
          {steps.map((s, i) => (
            <li class="step" data-reveal>
              <span class="step__num" aria-hidden="true">0{i + 1}</span>
              <h3 class="h3">{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section section--card" id="work" aria-labelledby="work-title">
      <div class="wrap">
        <header class="head" data-reveal>
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-play"/></svg>Project Videos</span>
          <h2 class="h2" id="work-title">See Our Work</h2>
          <p>Walk through recent remodels around the Bay Area.</p>
        </header>
        <div class="videos">
          {videos.map((v, i) => (
            <figure class={`video${i === 0 ? ' video--lead' : ''}`} data-reveal>
              <div class="video__frame">
                <iframe src={`https://player.vimeo.com/video/${v.id}?badge=0&autopause=0&player_id=0&app_id=58479`} title={`${v.title}, ${v.place}`} loading="lazy" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
              </div>
              <figcaption><strong>{v.title}</strong><span><svg class="ico" aria-hidden="true"><use href="#i-pin"/></svg>{v.place}</span></figcaption>
            </figure>
          ))}
        </div>
        <p class="video__more"><a class="link" href="/portfolio/videos/">See all project videos <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a></p>
      </div>
    </section>

    <section class="section promise" id="promise" aria-labelledby="promise-title">
      <!-- AI-generated backdrops (OpenAI gpt-image-2), decorative only -->
      <div class="promise__slides" data-promise-slides aria-hidden="true">
        <img class="promise__bg is-on" src="/img/promise-1-1536.webp" srcset="/img/promise-1-800.webp 800w, /img/promise-1-1536.webp 1536w" sizes="100vw" width="1536" height="1024" alt="" loading="lazy" />
        <img class="promise__bg" src="/img/promise-2-1536.webp" srcset="/img/promise-2-800.webp 800w, /img/promise-2-1536.webp 1536w" sizes="100vw" width="1536" height="1024" alt="" loading="lazy" />
        <img class="promise__bg" src="/img/promise-3-1536.webp" srcset="/img/promise-3-800.webp 800w, /img/promise-3-1536.webp 1536w" sizes="100vw" width="1536" height="1024" alt="" loading="lazy" />
      </div>
      <div class="wrap">
        <header class="head head--center" data-reveal>
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-shield"/></svg>Our Promise</span>
          <h2 class="h2" id="promise-title">Renovation Shouldn’t Be a Gamble</h2>
          <p>A beautiful home starts with a stress-free experience. From the first sketch to the final inspection, we put transparency and precision first. Here is our promise to you.</p>
        </header>
        <ol class="promises">
          {promises.map((p, i) => (
            <li class="promise__card" data-reveal>
              <span class="promise__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="h3">{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="promise__cta"><a class="btn btn--accent btn--lg" href="/#estimate">Get Started Today <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
      </div>
    </section>

    <section class="section award" id="award" aria-labelledby="award-title">
      <div class="wrap award__inner">
        <figure class="award__media" data-reveal>
          <img src="/img/award-top3-sunnyvale-2025.webp" width="500" height="470" alt="Two BusinessRate award plaques for Rose Remodeling & Design: Top 3 Construction Company, Sunnyvale, California, Google Reviews, July 2025" loading="lazy" />
        </figure>
        <div class="award__copy" data-reveal>
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-star"/></svg>Award</span>
          <p class="award__kicker">Congratulations!</p>
          <h2 class="h2" id="award-title">A Top 3 Business in Sunnyvale</h2>
          <p>Rose Remodeling &amp; Design was named a Top 3 construction company in Sunnyvale by BusinessRate, based on our Google reviews. Thank you to every homeowner who trusted us with their home.</p>
          <p class="award__meta"><img src="/img/badges/google-48.webp" width="48" height="48" alt="" aria-hidden="true" /> <a href={site.googleReviews} target="_blank" rel="noopener">Google Reviews</a> <span class="award__dot" aria-hidden="true"></span> July 2025</p>
          <div class="award__actions">
            <a class="btn btn--dark" href={site.googleReviews} target="_blank" rel="noopener" aria-label="Read our reviews on Google (opens in a new tab)">Read Our Reviews <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a>
            <a class="link" href="/#estimate">Get a free estimate <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a>
          </div>
        </div>
      </div>
    </section>

    <section class="section dark cta cta--img" id="reviews" aria-labelledby="reviews-title">
      <!-- AI-generated backdrop (OpenAI gpt-image-2), decorative -->
      <img class="cta__bg" src="/img/reviews-bg-living-room-1536.webp" srcset="/img/reviews-bg-living-room-800.webp 800w, /img/reviews-bg-living-room-1536.webp 1536w" sizes="100vw" width="1536" height="1024" alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="wrap">
        <header class="head" data-reveal>
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-star"/></svg>Reviews</span>
          <h2 class="h2" id="reviews-title">Rated Excellent, Everywhere We’re Reviewed</h2>
          <p>100+ reviews across Google, Yelp, Thumbtack and HomeAdvisor. A few of our favorites:</p>
        </header>
        <ul class="platforms" data-reveal>
          {platforms.map((pf) => (
            <li class="platform">
              <span class={`plogo plogo--${pf.key}`}>
                {pf.key === 'google' && <img src="/img/badges/google-48.webp" width="48" height="48" alt="" />}
                {pf.key === 'thumbtack' && <img src="/img/badges/thumbtack-48.webp" width="48" height="48" alt="" />}
                {pf.key === 'yelp' ? <img class="plogo__word" src="/img/badges/yelp-white.webp" width="288" height="110" alt="Yelp" /> : <span>{pf.name}</span>}
              </span>
              <span class="stars" role="img" aria-label="5 out of 5 stars">★★★★★</span>
              <span class="platform__meta"><strong>{pf.label}</strong>{pf.count ? ` · ${pf.count} reviews` : ''}</span>
            </li>
          ))}
        </ul>
        <div class="rtabs" role="group" aria-label="Filter reviews by site" data-reveal>
          <button type="button" aria-pressed="true" data-filter="all">All</button>
          {platforms.filter((pf) => reviews.some((r) => r.platform === pf.key)).map((pf) => (
            <button type="button" aria-pressed="false" data-filter={pf.key}>{pf.name}</button>
          ))}
        </div>
        <div class="rcarousel">
          <ul class="rlist" data-rlist tabindex="0" aria-label="Customer reviews">
            {reviews.map((r) => {
              const pf = platforms.find((x) => x.key === r.platform)!;
              return (
                <li class="rcard" data-platform={r.platform}>
                  <div class="rcard__top">
                    <span class="rcard__avatar" aria-hidden="true">{r.who.charAt(0)}</span>
                    <span class="rcard__who"><strong>{r.who}</strong><small>{r.when}</small></span>
                    <span class={`rcard__src rcard__src--${r.platform}`}>{pf.name}</span>
                  </div>
                  <span class="stars" role="img" aria-label="5 out of 5 stars">★★★★★</span>
                  <p>“{r.quote}”</p>
                </li>
              );
            })}
          </ul>
          <div class="rnav">
            <button class="rnav__btn" type="button" data-rprev aria-label="Previous reviews"><svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></button>
            <button class="rnav__btn" type="button" data-rnext aria-label="Next reviews"><svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></button>
          </div>
        </div>
      </div>
    </section>

    {showBadges && (
    <section class="badges" aria-labelledby="badges-title">
      <div class="wrap badges__inner">
        <h2 class="badges__title" id="badges-title">Find us on</h2>
        <ul class="badges__list">
          <li><img src="/img/badges/thumbtack.webp" width="93" height="93" alt="Thumbtack" loading="lazy" /></li>
          <li><img src="/img/badges/house-badge.webp" width="132" height="131" alt="Home services directory" loading="lazy" /></li>
          <li><img src="/img/badges/google.webp" width="85" height="86" alt="Google" loading="lazy" /></li>
          <li><img class="is-homemag" src="/img/badges/thehomemag.webp" width="480" height="72" alt="TheHomeMag" loading="lazy" /></li>
          <li><img class="is-houzz" src="/img/badges/houzz.webp" width="400" height="92" alt="Houzz" loading="lazy" /></li>
          <li><img class="is-angi" src="/img/badges/angi.webp" width="128" height="76" alt="Angi" loading="lazy" /></li>
          <li><img src="/img/badges/instagram.webp" width="100" height="98" alt="Instagram" loading="lazy" /></li>
        </ul>
      </div>
    </section>
    )}

    <section class="section" id="areas" aria-labelledby="areas-title">
      <div class="wrap">
        <header class="head" data-reveal>
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-pin"/></svg>Service Area</span>
          <h2 class="h2" id="areas-title">Where We Work</h2>
          <p>Based in Sunnyvale, serving the South Bay, Peninsula and East Bay. Not listed? <a href={tel}>Call us</a>, we may still cover it.</p>
        </header>
        <ul class="areas" data-reveal>
          {site.areaServed.map((a) => <li><svg class="ico" aria-hidden="true"><use href="#i-pin"/></svg>{a}</li>)}
        </ul>
      </div>
    </section>

    <section class="section section--card" id="faq" aria-labelledby="faq-title">
      <div class="wrap faq">
        <header class="head" data-reveal>
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-shield"/></svg>FAQ</span>
          <h2 class="h2" id="faq-title">Common Questions</h2>
          <p>Quick answers to what homeowners ask most. Have another question? Call us anytime, we’re happy to help.</p>
          <ul class="facts">
            <li><svg class="ico" aria-hidden="true"><use href="#i-phone"/></svg><a href={tel}>{site.phoneDisplay}</a></li>
            <li><svg class="ico" aria-hidden="true"><use href="#i-mail"/></svg><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><svg class="ico" aria-hidden="true"><use href="#i-shield"/></svg>{site.license}</li>
          </ul>
        </header>
        <div data-reveal>
          {faqs.map((f) => (
            <details><summary>{f.q}<svg class="ico" aria-hidden="true"><use href="#i-down"/></svg></summary><p>{f.a}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section class="section dark cta cta--img" id="estimate" aria-labelledby="cta-title">
      <img class="cta__bg" src="/img/portfolio/kitchen/kitchen-remodel-white-quartz-island-oak-cabinets-04.webp" srcset="/img/portfolio/kitchen/kitchen-remodel-white-quartz-island-oak-cabinets-04-800.webp 800w, /img/portfolio/kitchen/kitchen-remodel-white-quartz-island-oak-cabinets-04.webp 1600w" sizes="100vw" width="1600" height="1067" alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="wrap cta__inner">
        <div class="cta__copy">
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-clipboard"/></svg>Free Estimate</span>
          <h2 class="h2" id="cta-title">Ready to Start Your Remodel?</h2>
          <p>Tell us about the project. Adir will call you back to talk it through and book a free in-home consultation.</p>
          <p>Prefer to talk now? <a href={tel}>{site.phoneDisplay}</a></p>
        </div>
        <EstimateForm />
      </div>
    </section>

  <script>
    // Hero slideshow (extra slides load after the page has finished loading)
    const lazySlides = () => document.querySelectorAll<HTMLImageElement>('[data-hero-slides] img[data-src]').forEach((i) => { if (i.dataset.srcset) i.srcset = i.dataset.srcset; i.src = i.dataset.src!; i.removeAttribute('data-src'); });
    if (document.readyState === 'complete') setTimeout(lazySlides, 1500); else addEventListener('load', () => setTimeout(lazySlides, 1500));
    const heroSlides = document.querySelectorAll('[data-hero-slides] img');
    if (heroSlides.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let h = 0;
      setInterval(() => { heroSlides[h].classList.remove('is-on'); h = (h + 1) % heroSlides.length; heroSlides[h].classList.add('is-on'); }, 6000);
    }

    // Our Promise backdrop: slow crossfade
    const pSlides = document.querySelectorAll('[data-promise-slides] img');
    if (pSlides.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let q = 0;
      setInterval(() => { pSlides[q].classList.remove('is-on'); q = (q + 1) % pSlides.length; pSlides[q].classList.add('is-on'); }, 7000);
    }

    // Reviews: filter by site, and arrow buttons scroll the row.
    const rlist = document.querySelector<HTMLElement>('[data-rlist]');
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
      rlist?.querySelectorAll<HTMLElement>('[data-platform]').forEach((c) => { c.hidden = t.dataset.filter !== 'all' && c.dataset.platform !== t.dataset.filter; });
      rlist?.scrollTo({ left: 0 });
    }));
    const step = () => (rlist?.clientWidth ?? 300) * 0.9;
    document.querySelector('[data-rprev]')?.addEventListener('click', () => rlist?.scrollBy({ left: -step(), behavior: 'smooth' }));
    document.querySelector('[data-rnext]')?.addEventListener('click', () => rlist?.scrollBy({ left: step(), behavior: 'smooth' }));

  </script>
</SiteLayout>
