---
import Base from '../layouts/Base.astro';
import Icons from '../components/Icons.astro';
import { site, services, steps, promises, projects, reviews, faqs } from '../data/site';
const tel = `tel:${site.phoneTel}`;
const year = new Date().getFullYear();
const nav = [['#services', 'Services'], ['#process', 'Process'], ['#promise', 'Our Promise'], ['#work', 'Projects'], ['#reviews', 'Reviews'], ['#faq', 'FAQ']];
const Logo = `<svg width="36" height="36" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="19" fill="#E7B7AE"/><path d="M12 24c0-5 4-9 8-9s8 4 8 9M20 15v-4M16 13l4-3 4 3" fill="none" stroke="#1C191A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---
<Base
  title="Kitchen & Bath Remodeling in Sunnyvale | Rose Remodeling & Design"
  description="Licensed Bay Area design-build remodeler for kitchens, bathrooms, ADUs, additions and whole homes. Free in-home consultation. Call (510) 402-7165."
>
  <Icons />
  <a class="skip" href="#main">Skip to content</a>

  <header class="bar">
    <div class="bar__inner">
      <a class="brand" href="/"><Fragment set:html={Logo} /><span>Rose Remodeling<small>&amp; Design</small></span></a>
      <nav class="bar__nav" id="site-nav" aria-label="Main">
        {nav.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
      <a class="btn bar__phone" href={tel} aria-label={`Call ${site.phoneDisplay}`}><svg class="ico" aria-hidden="true"><use href="#i-phone"/></svg><span>{site.phoneDisplay}</span></a>
      <a class="btn btn--accent bar__quote" href="#estimate">Free Estimate</a>
      <button class="bar__menu" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu"><svg class="ico" aria-hidden="true"><use href="#i-menu"/></svg></button>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <img class="hero__bg" src="/img/hero-backyard-1600.webp" srcset="/img/hero-backyard-800.webp 800w, /img/hero-backyard-1600.webp 1600w" sizes="100vw" width="1600" height="1064" alt="Backyard remodel at dusk: a covered composite deck with lit steps, a white pergola, lounge seating and a lawn" fetchpriority="high" />
      <div class="wrap hero__inner">
        <div class="hero__copy">
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-star"/></svg>Top 3 remodeler in Sunnyvale · 2025</span>
          <h1 class="hero__title" id="hero-title">Kitchen &amp; Bath Remodeling in <em>Sunnyvale</em> and the Bay Area</h1>
          <p class="hero__lead">Kitchens, bathrooms, ADUs, additions and whole homes, designed, permitted and built by one licensed team, with daily updates from your project manager.</p>
          <div class="hero__actions" data-hero-actions>
            <a class="btn btn--accent btn--lg" href="#estimate">Get a Free Estimate <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a>
            <a class="btn btn--outline btn--lg" href={tel}><svg class="ico" aria-hidden="true"><use href="#i-phone"/></svg> {site.phoneDisplay}</a>
          </div>
          <ul class="facts">
            <li><svg class="ico" aria-hidden="true"><use href="#i-shield"/></svg> {site.license} · insured &amp; bonded</li>
            <li><svg class="ico" aria-hidden="true"><use href="#i-clipboard"/></svg> Permits handled</li>
            <li><svg class="ico" aria-hidden="true"><use href="#i-pin"/></svg> Sunnyvale &amp; Bay Area</li>
          </ul>
        </div>
        <div class="hero__media">
          <div class="score">
            <strong>{site.rating.value}</strong>
            <span><span class="stars" aria-hidden="true">★★★★★</span><br />Rated Excellent · {site.rating.count} Google reviews</span>
          </div>
        </div>
      </div>
    </section>

    <div class="ticker" role="region" aria-label="Service areas">
      <ul class="ticker__track">{site.areaServed.map((a) => <li>{a}</li>)}</ul>
      <ul class="ticker__track" aria-hidden="true">{site.areaServed.map((a) => <li>{a}</li>)}</ul>
    </div>

    <section class="badges" aria-labelledby="badges-title">
      <div class="wrap badges__inner">
        <h2 class="badges__title" id="badges-title">Find us on</h2>
        <ul class="badges__list">
          <li><img src="/img/badges/thumbtack.png" width="93" height="93" alt="Thumbtack" loading="lazy" /></li>
          <li><img src="/img/badges/house-badge.png" width="132" height="131" alt="Home services directory" loading="lazy" /></li>
          <li><img src="/img/badges/google.png" width="85" height="86" alt="Google" loading="lazy" /></li>
          <li><img class="is-word" src="/img/badges/thehomemag.png" width="132" height="42" alt="TheHomeMag" loading="lazy" /></li>
          <li><img class="is-word" src="/img/badges/houzz.png" width="96" height="31" alt="Houzz" loading="lazy" /></li>
          <li><img class="is-angi" src="/img/badges/angi.png" width="128" height="76" alt="Angi" loading="lazy" /></li>
          <li><img src="/img/badges/instagram.png" width="100" height="98" alt="Instagram" loading="lazy" /></li>
        </ul>
      </div>
    </section>

    <section class="section section--card" id="services" aria-labelledby="services-title">
      <div class="wrap">
        <header class="head" data-reveal>
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-layers"/></svg>Services</span>
          <h2 class="h2" id="services-title">What We Build</h2>
          <p>One design-build team and one contract, from a single bathroom to a new home.</p>
        </header>
        <ul class="svcs">
          {services.map((s, i) => (
            <li class="svc" data-reveal>
              {s.img
                ? <img class="svc__img" src={s.img} style={`object-position: ${s.pos}`} width="800" height="1000" alt={`Illustration: ${s.name.toLowerCase()}`} loading="lazy" />
                : <div class={`ph${i % 2 ? ' ph--light' : ''}`} role="img" aria-label={`${s.name} project`}><span><svg class="ico" aria-hidden="true"><use href="#i-image"/></svg>Photo: {s.name}</span></div>}
              <h3 class="h3"><span class="tile"><svg class="ico" aria-hidden="true"><use href={`#i-${s.icon}`}/></svg></span>{s.name}</h3>
              <p>{s.blurb}</p>
              <ul class="svc__list">{s.bullets.map((b) => <li>{b}</li>)}</ul>
              <a class="link" href="#estimate" aria-label={`Get an estimate for ${s.name.toLowerCase()}`}>Get an estimate <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="process" aria-labelledby="process-title">
      <div class="wrap">
        <header class="head" data-reveal>
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-clipboard"/></svg>Process</span>
          <h2 class="h2" id="process-title">How a Project Runs</h2>
          <p>Three stages, with a written proposal and a schedule before any wall comes down.</p>
        </header>
        <ol class="steps">
          {steps.map((s, i) => (
            <li class="step" data-reveal>
              <span class="step__num" aria-hidden="true">0{i + 1}</span>
              <h3 class="h3">{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section promise" id="promise" aria-labelledby="promise-title">
      <img class="promise__bg" src="/img/kitchen.svg" alt="" aria-hidden="true" loading="lazy" />
      <div class="wrap">
        <header class="head head--center" data-reveal>
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-shield"/></svg>Our Promise</span>
          <h2 class="h2" id="promise-title">Renovation Shouldn’t Be a Gamble</h2>
          <p>A beautiful home starts with a stress-free experience. From the first sketch to the final inspection, we put transparency and precision first. Here is our promise to you.</p>
        </header>
        <ol class="promises">
          {promises.map((p, i) => (
            <li class="promise__card" data-reveal>
              <span class="promise__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="h3">{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="promise__cta"><a class="btn btn--accent btn--lg" href="#estimate">Get Started Today <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
      </div>
    </section>

    <section class="section section--card" id="work" aria-labelledby="work-title">
      <div class="wrap">
        <header class="head" data-reveal>
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-grid"/></svg>Projects</span>
          <h2 class="h2" id="work-title">Before &amp; After</h2>
          <p>Recent remodels around the Bay Area.</p>
        </header>
        <div class="work">
          {projects.map((p) => (
            <figure data-reveal>
              <div class="ba">
                <div class="ph ph--light" role="img" aria-label={`${p.title}, before`}><span>Before</span></div>
                <div class="ph" role="img" aria-label={`${p.title}, after`}><span>After</span></div>
              </div>
              <figcaption><strong>{p.title}</strong><span><svg class="ico" aria-hidden="true"><use href="#i-pin"/></svg>{p.place}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="section award" id="award" aria-labelledby="award-title">
      <div class="wrap award__inner">
        <figure class="award__media" data-reveal>
          <img src="/img/award-top3-sunnyvale-2025.webp" width="500" height="470" alt="Two BusinessRate award plaques for Rose Remodeling & Design: Top 3 Construction Company, Sunnyvale, California, Google Reviews, July 2025" loading="lazy" />
        </figure>
        <div class="award__copy" data-reveal>
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-star"/></svg>Award</span>
          <p class="award__kicker">Congratulations!</p>
          <h2 class="h2" id="award-title">A Top 3 Business in Sunnyvale</h2>
          <p>Rose Remodeling &amp; Design was named a Top 3 construction company in Sunnyvale by BusinessRate, based on our Google reviews. Thank you to every homeowner who trusted us with their home.</p>
          <p class="award__meta"><img src="/img/badges/google.png" width="85" height="86" alt="" aria-hidden="true" /> Google Reviews <span class="award__dot" aria-hidden="true"></span> July 2025</p>
          <div class="award__actions">
            <a class="btn btn--dark" href="#reviews">Read Our Reviews <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a>
            <a class="link" href="#estimate">Get a free estimate <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></a>
          </div>
        </div>
      </div>
    </section>

    <section class="section dark" id="reviews" aria-labelledby="reviews-title">
      <div class="wrap">
        <header class="head" data-reveal>
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-star"/></svg>Reviews</span>
          <h2 class="h2" id="reviews-title">Homeowners on Adir &amp; the Crew</h2>
          <p>Short excerpts from Google reviews.</p>
        </header>
        <div class="quotes">
          {reviews.map((r) => (
            <blockquote class="quote" data-reveal>
              <span class="stars" role="img" aria-label="5 out of 5 stars">★★★★★</span>
              <p>“{r.quote}”</p>
              <footer>{r.who} · {r.job}</footer>
            </blockquote>
          ))}
        </div>
        <div class="proof">
          <span><strong>{site.rating.count}</strong>Google reviews, rated Excellent</span>
          <span><strong>100+</strong>reviews incl. HomeAdvisor</span>
          <span><strong>Top 3</strong>in Sunnyvale, 2025</span>
        </div>
      </div>
    </section>

    <section class="section" id="areas" aria-labelledby="areas-title">
      <div class="wrap">
        <header class="head" data-reveal>
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-pin"/></svg>Service Area</span>
          <h2 class="h2" id="areas-title">Where We Work</h2>
          <p>Based in Sunnyvale, serving the South Bay, Peninsula and East Bay. Not listed? <a href={tel}>Call us</a>, we may still cover it.</p>
        </header>
        <ul class="areas" data-reveal>
          {site.areaServed.map((a) => <li><svg class="ico" aria-hidden="true"><use href="#i-pin"/></svg>{a}</li>)}
        </ul>
      </div>
    </section>

    <section class="section section--card" id="faq" aria-labelledby="faq-title">
      <div class="wrap faq">
        <header class="head" data-reveal>
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-shield"/></svg>FAQ</span>
          <h2 class="h2" id="faq-title">Before You Call</h2>
          <p>The questions homeowners ask us first.</p>
          <ul class="facts">
            <li><svg class="ico" aria-hidden="true"><use href="#i-phone"/></svg><a href={tel}>{site.phoneDisplay}</a></li>
            <li><svg class="ico" aria-hidden="true"><use href="#i-mail"/></svg><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><svg class="ico" aria-hidden="true"><use href="#i-shield"/></svg>{site.license}</li>
          </ul>
        </header>
        <div data-reveal>
          {faqs.map((f) => (
            <details><summary>{f.q}<svg class="ico" aria-hidden="true"><use href="#i-down"/></svg></summary><p>{f.a}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section class="section dark cta" id="estimate" aria-labelledby="cta-title">
      <div class="wrap cta__inner">
        <div class="cta__copy">
          <span class="pill"><svg class="ico" aria-hidden="true"><use href="#i-clipboard"/></svg>Free Estimate</span>
          <h2 class="h2" id="cta-title">Ready to Start Your Remodel?</h2>
          <p>Tell us about the project. Adir will call you back to talk it through and book a free in-home consultation.</p>
          <p>Prefer to talk now? <a href={tel}>{site.phoneDisplay}</a></p>
        </div>
        <form id="estimate-form" method="post" action={site.formAction || undefined} data-email={site.email}>
          <div class="row">
            <label>Your name<input type="text" name="name" autocomplete="name" required /></label>
            <label>Phone<input type="tel" name="phone" autocomplete="tel" required /></label>
          </div>
          <div class="row">
            <label>ZIP code<input type="text" name="zip" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{5}" /></label>
            <label>Project
              <select name="project">{services.map((s) => <option>{s.name}</option>)}</select>
            </label>
          </div>
          <button type="submit" class="btn btn--accent btn--lg">Get My Free Estimate <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></button>
          <small>No obligation. We reply within one business day.</small>
        </form>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot__grid">
      <div>
        <a class="brand" href="/"><Fragment set:html={Logo} /><span>Rose Remodeling<small>&amp; Design</small></span></a>
        <p>Design-build remodeling for Sunnyvale and Bay Area homes. Licensed, insured and bonded.</p>
      </div>
      <div>
        <p class="foot__head">Contact</p>
        <a href={tel}>{site.phoneDisplay}</a>
        <a href={`mailto:${site.email}`}>Email Adir</a>
        <a href="#estimate">Free estimate</a>
      </div>
      <div>
        <p class="foot__head">Services</p>
        {services.slice(0, 4).map((s) => <a href="#services">{s.name}</a>)}
      </div>
      <div>
        <p class="foot__head">Explore</p>
        {nav.map(([href, label]) => <a href={href}>{label}</a>)}
      </div>
    </div>
    <div class="wrap foot__legal">
      <p>© {year} {site.legalName} · {site.license}</p>
      <p>Sunnyvale, CA</p>
    </div>
  </footer>

  <div class="dock" data-dock>
    <a class="btn btn--outline" href={tel} aria-label={`Call ${site.phoneDisplay}`}><svg class="ico" aria-hidden="true"><use href="#i-phone"/></svg> Call</a>
    <a class="btn btn--accent" href="#estimate">Free Estimate</a>
  </div>

  <script>
    // Phone menu
    const menu = document.querySelector<HTMLButtonElement>('.bar__menu');
    const nav = document.getElementById('site-nav');
    menu?.addEventListener('click', () => {
      const open = menu.getAttribute('aria-expanded') !== 'true';
      menu.setAttribute('aria-expanded', String(open));
      nav?.classList.toggle('is-open', open);
    });
    nav?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) { menu?.setAttribute('aria-expanded', 'false'); nav.classList.remove('is-open'); }
    });

    // Reveal on scroll
    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); }
    }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

    // Phone dock: shown when the hero buttons and the estimate form are both out of view
    const dock = document.querySelector('[data-dock]');
    const watched = [document.querySelector('[data-hero-actions]'), document.getElementById('estimate')].filter(Boolean) as Element[];
    const visible = new Set<Element>();
    const dio = new IntersectionObserver((entries) => {
      entries.forEach((en) => (en.isIntersecting ? visible.add(en.target) : visible.delete(en.target)));
      dock?.classList.toggle('is-on', visible.size === 0);
    });
    watched.forEach((el) => dio.observe(el));

    // No form endpoint configured: hand the request to the visitor's email app.
    const form = document.getElementById('estimate-form') as HTMLFormElement | null;
    if (form && !form.getAttribute('action')) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const d = new FormData(form);
        const body = ['name', 'phone', 'zip', 'project'].map((k) => `${k}: ${d.get(k) ?? ''}`).join('\n');
        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Free estimate request')}&body=${encodeURIComponent(body)}`;
      });
    }
  </script>
</Base>
