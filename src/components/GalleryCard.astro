---
import type { Gallery } from '../data/galleries';
interface Props { g: Gallery }
const { g } = Astro.props;
---
<li class="gcard" data-reveal>
  <a href={`/portfolio/photo-galleries/${g.slug}/`}>
    <span class="gcard__media"><img src={g.cover.src} width={g.cover.width} height={g.cover.height} alt="" loading="lazy" /></span>
    <span class="gcard__body">
      <span class="gcard__label">{g.label}</span>
      <span class="gcard__blurb">{g.blurb}</span>
      <span class="gcard__go">View gallery <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></span>
    </span>
  </a>
</li>
