---
// Dark title band for inner pages, with breadcrumb.
interface Props { title: string; intro?: string; crumbs: { href?: string; label: string }[]; image?: { src: string; srcset?: string } }
const { title, intro, crumbs, image } = Astro.props;
---
<section class:list={["pagehead", { "pagehead--img": image }]}>
  {image && <img class="pagehead__bg" src={image.src} srcset={image.srcset} sizes={image.srcset ? "100vw" : undefined} alt="" aria-hidden="true" fetchpriority="high" />}
  <div class="wrap pagehead__inner">
    <nav aria-label="Breadcrumb">
      <ol class="crumbs">
        {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
      </ol>
    </nav>
    <h1 class="pagehead__title">{title}</h1>
    {intro && <p class="pagehead__intro">{intro}</p>}
    <slot />
  </div>
</section>
