---
import { site, services } from '../data/site';
interface Props { message?: boolean; id?: string; selected?: string }
const { id = 'estimate-form', selected } = Astro.props;
// FORMS=netlify: submissions go to Netlify Forms (set up email notifications in the Netlify UI).
const netlify = process.env.FORMS === 'netlify';
const action = netlify ? '/thank-you/' : site.formAction || undefined;
const timelines = ['ASAP', '1–3 months', '3–6 months', '6+ months', 'Just exploring'];
---
<form id={id} class="estimate-form" name="estimate" method="post" action={action} data-email={site.email} data-netlify={netlify ? "true" : undefined} netlify-honeypot={netlify ? "bot-field" : undefined}>
  {netlify && <input type="hidden" name="form-name" value="estimate" />}
  {netlify && <p hidden><label>Leave this empty<input name="bot-field" /></label></p>}
  <div class="row">
    <label>Your Name<input type="text" name="name" autocomplete="name" required /></label>
    <label>Phone Number<input type="tel" name="phone" autocomplete="tel" required /></label>
  </div>
  <div class="row">
    <label>Email Address<input type="email" name="email" autocomplete="email" required /></label>
    <label>ZIP Code<input type="text" name="zip" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{5}" /></label>
  </div>
  <div class="row">
    <label>Project Type
      <select name="project">{services.map((s) => <option selected={s.name === selected}>{s.name}</option>)}</select>
    </label>
    <label>Project Timeline
      <select name="timeline" required>
        <option value="" selected disabled>Choose a start</option>
        {timelines.map((t) => <option>{t}</option>)}
      </select>
    </label>
  </div>
  <label>Your Message<textarea name="message" rows="4" placeholder="Tell us about your project: rooms, goals, budget range…"></textarea></label>
  <button type="submit" class="btn btn--accent btn--lg">Get My Free Estimate <svg class="ico" aria-hidden="true"><use href="#i-arrow"/></svg></button>
  <small>Free consultation. No obligation.</small>
</form>

<script>
  // No form endpoint configured (site.formAction is empty): hand the request to the visitor's email app.
  document.querySelectorAll<HTMLFormElement>('form.estimate-form').forEach((form) => {
    if (form.getAttribute('action')) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const body = ['name', 'phone', 'email', 'zip', 'project', 'timeline', 'message'].filter((k) => d.has(k)).map((k) => `${k}: ${d.get(k) ?? ''}`).join('\n');
      location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Free estimate request')}&body=${encodeURIComponent(body)}`;
    });
  });
</script>
