---
import Base from './Base.astro';
import Icons from '../components/Icons.astro';
import { site, services } from '../data/site';
import { mainNav } from '../data/nav';
import { serviceHref } from '../data/servicePages';

interface Props { title: string; description: string; image?: string; schema?: object[]; preload?: { src: string; srcset?: string; sizes?: string }; crumbs?: { href?: string; label: string }[]; noindex?: boolean }
const { title, description, image, schema = [], preload, crumbs, noindex } = Astro.props;
const crumbLd = crumbs && crumbs.length > 1 ? [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, ...(c.href || i === crumbs.length - 1 ? { item: new URL(c.href ?? Astro.url.pathname, Astro.site).href } : {}) })) }] : [];
const tel = `tel:${site.phoneTel}`;
const year = new Date().getFullYear();
const here = Astro.url.pathname;
const flat = mainNav.flatMap((i) => ('items' in i ? [{ href: i.items[0].href, label: i.label }] : [i]));
---
<Base title={title} description={description} image={image} schema={[...crumbLd, ...schema]} preload={preload} noindex={noindex}>
  <Icons />
  <a class="skip" href="#main">Skip to content</a>

  <header class="bar">
    <div class="bar__inner">
      <a class="brand" href="/" aria-label="Rose Remodeling & Design, home"><img src="/img/logo-360.webp" srcset="/img/logo-360.webp 360w, /img/logo-468.webp 468w, /img/logo.webp 720w" sizes="234px" width="720" height="222" alt="Rose Remodeling & Design" fetchpriority="high" /></a>
      <nav class="bar__nav" id="site-nav" aria-label="Main">
        {mainNav.map((item) => 'items' in item ? (
          <div class="nav-group" data-nav-group>
            <button class="nav-group__btn" type="button" aria-expanded="false" aria-controls={item.id}>{item.label} <svg class="ico" aria-hidden="true"><use href="#i-down"/></svg></button>
            <ul class="nav-group__menu" id={item.id}>
              {item.items.map((l) => <li><a href={l.href} aria-current={l.href === here ? 'page' : undefined}><svg class="ico" aria-hidden="true"><use href={`#i-${l.icon}`}/></svg>{l.label}</a></li>)}
            </ul>
          </div>
        ) : <a href={item.href}>{item.label}</a>)}
      </nav>
      <a class="btn bar__phone" href={tel} aria-label={`Call ${site.phoneDisplay}`}><svg class="ico" aria-hidden="true"><use href="#i-phone"/></svg><span>{site.phoneDisplay}</span></a>
      <a class="btn btn--accent bar__quote" href="/free-estimate/">Free Estimate</a>
      <button class="bar__menu" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu"><svg class="ico" aria-hidden="true"><use href="#i-menu"/></svg></button>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap foot__grid">
      <div>
        <a class="brand" href="/" aria-label="Rose Remodeling & Design, home"><img src="/img/logo-footer-600.webp" srcset="/img/logo-footer-600.webp 600w, /img/logo-footer.webp 1100w" sizes="300px" width="1100" height="340" alt="Rose Remodeling & Design" loading="lazy" /></a>
        <p>Design-build remodeling for Sunnyvale and Bay Area homes. Licensed, insured and bonded.</p>
      </div>
      <div>
        <p class="foot__head">Contact</p>
        <a href={tel}>{site.phoneDisplay}</a>
        <a href={`mailto:${site.email}`}>Email Adir</a>
        <a href="/free-estimate/">Free estimate</a>
      </div>
      <div>
        <p class="foot__head">Services</p>
        {services.map((s) => <a href={serviceHref(s.name)}>{s.name}</a>)}
      </div>
      <div>
        <p class="foot__head">Explore</p>
        {flat.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="/portfolio/photo-galleries/">Photo Galleries</a>
      </div>
    </div>
    <div class="wrap foot__legal">
      <p>© {year} {site.legalName} · {site.license}</p>
      <p>Sunnyvale, CA</p>
    </div>
  </footer>

  <div class="dock" data-dock>
    <a class="btn btn--outline" href={tel} aria-label={`Call ${site.phoneDisplay}`}><svg class="ico" aria-hidden="true"><use href="#i-phone"/></svg> Call</a>
    <a class="btn btn--accent" href="/free-estimate/">Free Estimate</a>
  </div>

  <script>
    // Phone menu
    const menu = document.querySelector<HTMLButtonElement>('.bar__menu');
    const nav = document.getElementById('site-nav');
    menu?.addEventListener('click', () => {
      const open = menu.getAttribute('aria-expanded') !== 'true';
      menu.setAttribute('aria-expanded', String(open));
      nav?.classList.toggle('is-open', open);
    });
    nav?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) { menu?.setAttribute('aria-expanded', 'false'); nav.classList.remove('is-open'); }
    });

    // Dropdown submenus (Services, Portfolio)
    document.querySelectorAll<HTMLElement>('[data-nav-group]').forEach((group) => {
      const btn = group.querySelector<HTMLButtonElement>('button');
      const set = (open: boolean) => btn?.setAttribute('aria-expanded', String(open));
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        document.querySelectorAll('[data-nav-group] > button').forEach((b) => b.setAttribute('aria-expanded', 'false'));
        set(open);
      });
      document.addEventListener('click', (e) => { if (!group.contains(e.target as Node)) set(false); });
      group.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); btn?.focus(); } });
      group.addEventListener('focusout', (e) => { if (!group.contains(e.relatedTarget as Node)) set(false); });
    });

    // ---- Motion ----
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Scroll reveal. Grid children get a staggered delay; images inside reveal blocks zoom in slightly.
    const revealSel = '.head, .svc, .step, .promise__card, .vp, .gcard, .platform, .quote, .values li, .team__card, .shots li, .pgrid li, .areas li, .about__media, .award__media, .contact__form, .faq details, .incl li, .video, .perks li';
    document.querySelectorAll<HTMLElement>(revealSel).forEach((el) => { if (!el.hasAttribute('data-reveal')) el.setAttribute('data-reveal', ''); });
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
      const sibs = el.parentElement ? [...el.parentElement.children].filter((c) => c.hasAttribute('data-reveal')) : [];
      const i = sibs.indexOf(el);
      if (sibs.length > 1 && i > 0) el.style.setProperty('--d', `${Math.min(i, 8) * 70}ms`);
    });
    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); }
    }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

    // Headline: split into words that rise in on load.
    document.querySelectorAll<HTMLElement>('.hero__title, .pagehead__title').forEach((h) => {
      if (reduce) return;
      let n = 0;
      const wrap = (node: Node) => {
        [...node.childNodes].forEach((c) => {
          if (c.nodeType === 3) {
            const frag = document.createDocumentFragment();
            (c.textContent || '').split(/(\s+)/).forEach((w) => {
              if (!w) return;
              if (/^\s+$/.test(w)) { frag.append(w); return; }
              const s = document.createElement('span'); s.className = 'word'; s.style.setProperty('--w', String(n++));
              const inner = document.createElement('span'); inner.textContent = w; s.append(inner); frag.append(s);
            });
            c.replaceWith(frag);
          } else if (c.nodeType === 1) wrap(c);
        });
      };
      wrap(h); h.classList.add('words');
    });
    requestAnimationFrame(() => document.documentElement.classList.add('is-loaded'));

    // Count-up numbers (e.g. 5.0, 50, 100+) when they scroll into view.
    const counters = document.querySelectorAll<HTMLElement>('.score strong, .platform__meta strong, .step__num, .promise__num, .values__num');
    const cio = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (!en.isIntersecting) return; cio.unobserve(en.target);
      const el = en.target as HTMLElement; const txt = el.textContent || '';
      const m = txt.match(/^(\D*)(\d+(?:\.\d+)?)(.*)$/); if (!m || reduce) return;
      const [, pre, num, post] = m; const end = parseFloat(num); const dec = (num.split('.')[1] || '').length; const pad = num.length;
      const t0 = performance.now(), dur = 1100;
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3);
        let v = (end * e).toFixed(dec); if (!dec && num.startsWith('0')) v = v.padStart(pad, '0');
        el.textContent = pre + v + post; if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }), { threshold: .6 });
    counters.forEach((c) => cio.observe(c));

    // Header shrinks and gains a shadow after scrolling; a thin purple progress bar tracks the page.
    const bar = document.querySelector<HTMLElement>('.bar');
    const prog = document.createElement('div'); prog.className = 'scroll-progress'; prog.setAttribute('aria-hidden', 'true'); document.body.append(prog);
    let ticking = false;
    const onScroll = () => {
      ticking = false; const y = scrollY;
      bar?.classList.toggle('is-scrolled', y > 24);
      const h = document.documentElement.scrollHeight - innerHeight;
      prog.style.transform = `scaleX(${h > 0 ? y / h : 0})`;
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
    onScroll();

    // Gentle parallax on full-bleed photo backgrounds.
    const plx = [...document.querySelectorAll<HTMLElement>('.hero__slides, .pagehead__bg, .promise__slides, .cta__bg')];
    if (!reduce && plx.length) {
      const run = () => { plx.forEach((el) => { const r = el.parentElement!.getBoundingClientRect(); if (r.bottom < 0 || r.top > innerHeight) return; const max = r.height * 0.1; el.style.translate = `0 ${Math.round(Math.max(-max, Math.min(max, r.top * -0.12)))}px`; }); };
      addEventListener('scroll', () => requestAnimationFrame(run), { passive: true }); run();
    }

    // Magnetic hover on primary buttons (desktop pointers only).
    if (!reduce && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      document.querySelectorAll<HTMLElement>('.btn--accent, .btn--dark').forEach((b) => {
        b.addEventListener('pointermove', (e) => { const r = b.getBoundingClientRect(); b.style.translate = `${(e.clientX - r.left - r.width / 2) * .12}px ${(e.clientY - r.top - r.height / 2) * .2}px`; });
        b.addEventListener('pointerleave', () => { b.style.translate = ''; });
      });
    }

    // Phone dock: shown when the hero buttons and the estimate form are both out of view
    const dock = document.querySelector('[data-dock]');
    const watched = [document.querySelector('[data-hero-actions]'), document.getElementById('estimate')].filter(Boolean) as Element[];
    const visible = new Set<Element>();
    const dio = new IntersectionObserver((entries) => {
      entries.forEach((en) => (en.isIntersecting ? visible.add(en.target) : visible.delete(en.target)));
      dock?.classList.toggle('is-on', visible.size === 0);
    });
    watched.forEach((el) => dio.observe(el));

  </script>
</Base>
