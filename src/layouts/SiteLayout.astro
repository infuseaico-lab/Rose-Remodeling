---
import Base from './Base.astro';
import Icons from '../components/Icons.astro';
import { site, services } from '../data/site';
import { mainNav } from '../data/nav';
import { serviceHref } from '../data/servicePages';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const tel = `tel:${site.phoneTel}`;
const year = new Date().getFullYear();
const here = Astro.url.pathname;
const flat = mainNav.flatMap((i) => ('items' in i ? [{ href: i.items[0].href, label: i.label }] : [i]));
---
<Base title={title} description={description}>
  <Icons />
  <a class="skip" href="#main">Skip to content</a>

  <header class="bar">
    <div class="bar__inner">
      <a class="brand" href="/" aria-label="Rose Remodeling & Design, home"><img src="/img/logo.webp" width="720" height="222" alt="Rose Remodeling & Design" fetchpriority="high" /></a>
      <nav class="bar__nav" id="site-nav" aria-label="Main">
        {mainNav.map((item) => 'items' in item ? (
          <div class="nav-group" data-nav-group>
            <button class="nav-group__btn" type="button" aria-expanded="false" aria-controls={item.id}>{item.label} <svg class="ico" aria-hidden="true"><use href="#i-down"/></svg></button>
            <ul class="nav-group__menu" id={item.id}>
              {item.items.map((l) => <li><a href={l.href} aria-current={l.href === here ? 'page' : undefined}><svg class="ico" aria-hidden="true"><use href={`#i-${l.icon}`}/></svg>{l.label}</a></li>)}
            </ul>
          </div>
        ) : <a href={item.href}>{item.label}</a>)}
      </nav>
      <a class="btn bar__phone" href={tel} aria-label={`Call ${site.phoneDisplay}`}><svg class="ico" aria-hidden="true"><use href="#i-phone"/></svg><span>{site.phoneDisplay}</span></a>
      <a class="btn btn--accent bar__quote" href="/free-estimate/">Free Estimate</a>
      <button class="bar__menu" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu"><svg class="ico" aria-hidden="true"><use href="#i-menu"/></svg></button>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap foot__grid">
      <div>
        <a class="brand" href="/" aria-label="Rose Remodeling & Design, home"><img src="/img/logo-footer.webp" width="1100" height="340" alt="Rose Remodeling & Design" loading="lazy" /></a>
        <p>Design-build remodeling for Sunnyvale and Bay Area homes. Licensed, insured and bonded.</p>
      </div>
      <div>
        <p class="foot__head">Contact</p>
        <a href={tel}>{site.phoneDisplay}</a>
        <a href={`mailto:${site.email}`}>Email Adir</a>
        <a href="/free-estimate/">Free estimate</a>
      </div>
      <div>
        <p class="foot__head">Services</p>
        {services.map((s) => <a href={serviceHref(s.name)}>{s.name}</a>)}
      </div>
      <div>
        <p class="foot__head">Explore</p>
        {flat.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="/portfolio/photo-galleries/">Photo Galleries</a>
      </div>
    </div>
    <div class="wrap foot__legal">
      <p>© {year} {site.legalName} · {site.license}</p>
      <p>Sunnyvale, CA</p>
    </div>
  </footer>

  <div class="dock" data-dock>
    <a class="btn btn--outline" href={tel} aria-label={`Call ${site.phoneDisplay}`}><svg class="ico" aria-hidden="true"><use href="#i-phone"/></svg> Call</a>
    <a class="btn btn--accent" href="/free-estimate/">Free Estimate</a>
  </div>

  <script>
    // Phone menu
    const menu = document.querySelector<HTMLButtonElement>('.bar__menu');
    const nav = document.getElementById('site-nav');
    menu?.addEventListener('click', () => {
      const open = menu.getAttribute('aria-expanded') !== 'true';
      menu.setAttribute('aria-expanded', String(open));
      nav?.classList.toggle('is-open', open);
    });
    nav?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) { menu?.setAttribute('aria-expanded', 'false'); nav.classList.remove('is-open'); }
    });

    // Dropdown submenus (Services, Portfolio)
    document.querySelectorAll<HTMLElement>('[data-nav-group]').forEach((group) => {
      const btn = group.querySelector<HTMLButtonElement>('button');
      const set = (open: boolean) => btn?.setAttribute('aria-expanded', String(open));
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') !== 'true';
        document.querySelectorAll('[data-nav-group] > button').forEach((b) => b.setAttribute('aria-expanded', 'false'));
        set(open);
      });
      document.addEventListener('click', (e) => { if (!group.contains(e.target as Node)) set(false); });
      group.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); btn?.focus(); } });
      group.addEventListener('focusout', (e) => { if (!group.contains(e.relatedTarget as Node)) set(false); });
    });

    // Reveal on scroll
    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); }
    }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

    // Phone dock: shown when the hero buttons and the estimate form are both out of view
    const dock = document.querySelector('[data-dock]');
    const watched = [document.querySelector('[data-hero-actions]'), document.getElementById('estimate')].filter(Boolean) as Element[];
    const visible = new Set<Element>();
    const dio = new IntersectionObserver((entries) => {
      entries.forEach((en) => (en.isIntersecting ? visible.add(en.target) : visible.delete(en.target)));
      dock?.classList.toggle('is-on', visible.size === 0);
    });
    watched.forEach((el) => dio.observe(el));

  </script>
</Base>
