---
import '../styles/fonts.css';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Social share image (path under /public). */
  image?: string;
  /** Extra JSON-LD objects for this page (breadcrumbs, service, FAQ…). */
  schema?: object[];
  /** Hero/LCP image to preload. */
  preload?: { src: string; srcset?: string; sizes?: string };
  noindex?: boolean;
}
const { title, description, image = '/img/og-default.jpg', schema = [], preload, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${site.url}/#business`,
  name: site.legalName,
  alternateName: site.name,
  url: site.url,
  telephone: site.phoneTel,
  email: site.email,
  logo: `${site.url}/img/logo.webp`,
  image: `${site.url}/img/og-default.jpg`,
  priceRange: '$$$',
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressRegion: site.region, addressCountry: 'US' },
  areaServed: site.areaServed.map((name) => ({ '@type': 'City', name: `${name}, CA` })),
  hasCredential: { '@type': 'EducationalOccupationalCredential', credentialCategory: 'license', name: `California Contractor License #${site.licenseNumber}` },
  hasMap: site.googleReviews,
  knowsAbout: ['Kitchen remodeling', 'Bathroom remodeling', 'Full home remodeling', 'ADU construction', 'Room additions', 'New home construction'],
};
const ld = [business, ...schema];
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
  <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/google-sans-flex-latin.woff2" as="font" type="font/woff2" crossorigin />
  {preload && <link rel="preload" as="image" href={preload.src} imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />}
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap.xml" />
  <meta name="theme-color" content="#72254F" />
  <meta name="geo.region" content="US-CA" />
  <meta name="geo.placename" content="Sunnyvale" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <script is:inline>document.documentElement.classList.add("js")</script>
  <script type="application/ld+json" set:html={JSON.stringify(ld.length === 1 ? ld[0] : ld)} />
</head>
<body>
  <slot />
</body>
</html>
